NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/aiilsg_portal?replicaSet=rs0
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
HOST=127.0.0.1
STORAGE_DRIVER=local
# For Cloudinary, set STORAGE_DRIVER=cloudinary and all three credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Default 0: do not trust forwarded IP headers. Set only for a known proxy topology.
TRUST_PROXY_HOPS=0
# Optional absolute directory outside all web roots; persistent volume in production.
# PRIVATE_STORAGE_DIR=/var/lib/aiilsg/private-files
